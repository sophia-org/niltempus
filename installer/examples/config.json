{
  "profile": "~/.config/sophia/desktop.kdl",
  "niltempus": {
    "path": "/path/to/niltempus",
    "reference": "REPLACE_WITH_SIGNED_NILTEMPUS_COMMIT"
  },
  "inputs": {
    "hagia_nim_deps": {"path": "/path/to/reviewed/hagia.nim-deps", "sha256": "REPLACE_WITH_INDEPENDENTLY_SUPPLIED_SHA256"},
    "narthex_nim_deps": {"path": "/path/to/reviewed/narthex.nim-deps", "sha256": "REPLACE_WITH_INDEPENDENTLY_SUPPLIED_SHA256"},
    "hagia_c_sdk_revision": "REPLACE_WITH_THE_C_SDK_REVISION_HAGIA_VENDORS"
  },
  "repositories": {
    "sophia": {"path": "/path/to/sophia", "reference": "REPLACE_WITH_PINNED_SOPHIA_COMMIT"},
    "hagia": {"path": "/path/to/hagia", "reference": "REPLACE_WITH_SIGNED_HAGIA_COMMIT"},
    "narthex": {"path": "/path/to/narthex", "reference": "REPLACE_WITH_SIGNED_NARTHEX_COMMIT"},
    "lom": {"path": "/path/to/lom", "reference": "REPLACE_WITH_LOM_COMMIT"},
    "bemenu": {"path": "/path/to/bemenu", "reference": "REPLACE_WITH_BEMENU_COMMIT"}
  }
}
