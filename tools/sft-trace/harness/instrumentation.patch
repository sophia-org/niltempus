+// Trace-only patch: this module is never used by a native timing binary.
+impl FrameStream {
+    fn trace(&mut self, action: &str, tx: u64, generation: u64, stream: u64, returned: bool) {
+        use std::io::Write;
+        use std::sync::atomic::{AtomicU64, Ordering};
+        static NEXT: AtomicU64 = AtomicU64::new(1);
+        let Some(dir) = std::env::var_os("SFT_TRACE_DIR") else {
+            return;
+        };
+        let first = self.trace_id == 0;
+        if first {
+            self.trace_id = NEXT.fetch_add(1, Ordering::Relaxed);
+        }
+        let path = std::path::PathBuf::from(dir).join(format!(
+            "{}-{}.ndjson",
+            std::process::id(),
+            self.trace_id
+        ));
+        let mut options = std::fs::OpenOptions::new();
+        options.write(true);
+        if first {
+            options.create_new(true);
+        } else {
+            options.append(true);
+        }
+        let mut file = options.open(path).expect("trace file");
+        let time = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .unwrap()
+            .as_nanos();
+        let pending = self.pending.as_ref();
+        writeln!(
+            file,
+            concat!(
+                "{{\"tag\":\"trace\",\"timestamp\":\"{}\",\"action\":\"{}\",",
+                "\"tx\":{},\"generation\":{},\"stream\":{},\"returned\":{},\"state\":{{",
+                "\"phase\":\"{:?}\",\"key\":{},\"opening\":{},\"closing\":{},",
+                "\"last_stream\":{},\"last_candidate\":{},\"credit\":{},\"closed_notice\":{},",
+                "\"pending_tx\":{},\"pending_gen\":{},\"prepared\":{}}}}}"
+            ),
+            time,
+            action,
+            tx,
+            generation,
+            stream,
+            returned,
+            self.state,
+            self.key.map_or(0, |key| key.stream_id),
+            self.opening.map_or(0, TransactionId::raw),
+            self.closing.map_or(0, TransactionId::raw),
+            self.last_stream,
+            self.last_candidate,
+            self.credit,
+            self.closed_notice,
+            pending.map_or(0, |p| p.transaction.raw()),
+            pending.map_or(0, |p| p.generation),
+            pending.is_some_and(|p| p.prepared)
+        )
+        .unwrap();
+    }
+}
