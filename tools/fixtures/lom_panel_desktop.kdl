schema 1

// Probe overrides only. Policy and shortcuts come from the selected WM profile.
shell {
    enabled #true
    content #true
    content-input #true
    panel 24
    gpu "direct"
}
session {
    // The catalog makes Hagia's launcher action callable. The explicit empty
    // startup list independently guarantees that this panel gate starts no
    // unrelated application.
    application-catalog "lom-panel-gate"
    startup
}
input { inherit-sophia #true; }
output { inherit-sophia #true; }
broker { enabled #false; }
// Provenance: moved from Sophia tools/fixtures/lom_panel_desktop.kdl at 9fcaec782ce4fe9978568c0466ee17a78b3d4571 (Sophia rule 13).
