#!/usr/bin/env bash
# Provenance: moved from Sophia tools/installed/sophia-truecolor-proof at a6edbbcad02ad9e9bb4c790e7cfd714cf333d30b (original copy; source unchanged at the pin de776c68) (Sophia rule 13).
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
RELEASE_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
kitty_bin="$(command -v kitty 2>/dev/null || true)"
[[ -n "$kitty_bin" && -x "$kitty_bin" ]] || {
    echo "Sophia TrueColor proof requires Kitty on PATH." >&2
    exit 1
}

export SOPHIA_INSTALLED_ATTEMPT_MODE=truecolor
export SOPHIA_TRUECOLOR_PROOF=true
# The proof wrapper, rather than the general launcher, owns repeated final
# region readback and keeps full-frame diagnostics out of ordinary sessions.
export SOPHIA_NATIVE_COMPOSITION_PIXEL_TRACE=final-regions
export SOPHIA_TERMINAL_BIN="$kitty_bin"
export SOPHIA_TERMINAL_KIND=kitty
exec "$RELEASE_DIR/bin/sophia-hagia-session" "$@"
