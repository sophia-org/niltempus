#!/usr/bin/env bash
# Provenance: moved from Sophia tools/installed/sophia-xterm-proof at a6edbbcad02ad9e9bb4c790e7cfd714cf333d30b (original copy; source unchanged at the pin de776c68) (Sophia rule 13).
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
RELEASE_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
xterm_bin="$(command -v xterm 2>/dev/null || true)"
[[ -n "$xterm_bin" && -x "$xterm_bin" ]] || {
    echo "Sophia xterm proof requires xterm on PATH." >&2
    exit 1
}

export SOPHIA_INSTALLED_ATTEMPT_MODE=xterm
export SOPHIA_TERMINAL_BIN="$xterm_bin"
export SOPHIA_TERMINAL_KIND=xterm
exec "$RELEASE_DIR/bin/sophia-hagia-session" "$@"
