#!/usr/bin/env bash
# Provenance: moved from Sophia tools/installed/sophia-recovery-proof at a6edbbcad02ad9e9bb4c790e7cfd714cf333d30b (original copy; source unchanged at the pin de776c68) (Sophia rule 13).
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
RELEASE_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"

# Keep the deadline opt-in: an ordinary desktop session must not expire.
export SOPHIA_SESSION_WATCHDOG_SECONDS=45
export SOPHIA_INSTALLED_ATTEMPT_MODE=watchdog
exec "$RELEASE_DIR/bin/sophia-hagia-session" "$@"
