#!/usr/bin/env bash
# Provenance: moved from Sophia tools/installed/sophia-hagia-session at a6edbbcad02ad9e9bb4c790e7cfd714cf333d30b (original copy; source unchanged at the pin de776c68) (Sophia rule 13).
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
RELEASE_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"

packaged_profile="$RELEASE_DIR/share/sophia-policy/hagia/default.kdl"
# SOPHIA_DESKTOP_PROFILE_MODE selects (auto | packaged-promotion) and is then
# exported as the resolved mode Sophia records in sophia_live_desktop_profile.
# There is no legacy alias, and the retired per-client profile locations are not
# consulted: desktop.kdl is the one profile name.
case "${SOPHIA_DESKTOP_PROFILE_MODE:-auto}" in
    packaged-promotion)
        desktop_profile="$packaged_profile"
        profile_mode=packaged-promotion
        ;;
    auto)
        if [[ -n "${SOPHIA_DESKTOP_PROFILE:-}" ]]; then
            desktop_profile="$SOPHIA_DESKTOP_PROFILE"
            profile_mode=explicit
        else
            config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
            if [[ -e "$config_home/sophia/desktop.kdl" || -L "$config_home/sophia/desktop.kdl" ]]; then
                desktop_profile="$config_home/sophia/desktop.kdl"
                profile_mode=user
            elif [[ -e /etc/sophia/desktop.kdl || -L /etc/sophia/desktop.kdl ]]; then
                desktop_profile=/etc/sophia/desktop.kdl
                profile_mode=system
            else
                desktop_profile="$packaged_profile"
                profile_mode=packaged-fallback
            fi
        fi
        ;;
    *)
        echo "SOPHIA_DESKTOP_PROFILE_MODE must be auto or packaged-promotion." >&2
        exit 1
        ;;
esac
[[ "$desktop_profile" == /* && -f "$desktop_profile" ]] || {
    echo "Hagia desktop profile must be an absolute existing file: $desktop_profile" >&2
    exit 1
}
export SOPHIA_DESKTOP_PROFILE="$desktop_profile"
export SOPHIA_DESKTOP_PROFILE_SHA256="$(sha256sum "$desktop_profile" | awk '{ print $1 }')"
export SOPHIA_DESKTOP_PROFILE_MODE="$profile_mode"
export SOPHIA_TTY_PROFILE=hagia
export SOPHIA_INSTALLED_ATTEMPT_MODE="${SOPHIA_INSTALLED_ATTEMPT_MODE:-hagia}"
exec "$RELEASE_DIR/bin/sophia-session" "$@"
